# security-tests-m8 live configuration for:
# /workspace/media-service-m8/docker_compose/dev_local_media_m8
# you need to install security-tests-m8 in your python environment
# to run the tests.

# Live tests: issuer base URL (including its API prefix).
LIVE_TEST_AUTH_BASE=http://localhost:9000/user
# Internal service-to-service entrypoint that exposes /private/* . The public
# edge blocks /private (Traefik -> 404), so the F06 per-consumer legacy-shape
# check targets this URL. Falls back to LIVE_TEST_AUTH_BASE when unset.
LIVE_TEST_INTERNAL_AUTH_BASE=http://localhost:9000/user
LIVE_TEST_AUTH_HEALTH_URL=http://localhost:9000/user/health/
LIVE_TEST_SVC_BASE=http://localhost:9000/media
LIVE_TEST_SVC_BASES={"media":"http://localhost:9000/media"}
LIVE_TEST_DEFAULT_SVC=media

# Dedicated test-only superuser. Do not use FIRST_SUPERUSER from auth.env.
# Value: e-mail address of a dedicated admin test account, never
#   FIRST_SUPERUSER.
LIVE_TEST_ADMIN_EMAIL=changethis
# Value: 8-72 chars (bcrypt caps passwords at 72 bytes); mix upper, lower,
#   digit and a symbol (- _ . ~); no spaces, $, #, quotes or backslash.
LIVE_TEST_ADMIN_PASSWORD=changethis
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
LIVE_TEST_PRIVATE_API_SECRET=changethis
LIVE_TEST_PRIVATE_API_CLIENT_ID=media-service
# Deep /health detail credential. fa-auth-m8 >= 1.0.0 gates the detail body
# (token mode, Redis/DB) on a dedicated HEALTH_DETAIL_CREDENTIAL via
# X-Internal-Token, decoupled from PRIVATE_API_SECRET (must differ from it).
# Opt-in/fail-closed on the stack; set this to match once enabled in auth.env.
# Without it, require_redis and require_token_mode suites skip with an explicit
# reason instead of running blind on defaults.
# LIVE_TEST_HEALTH_DETAIL_CREDENTIAL=changethis
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
LIVE_TEST_REFRESH_SECRET_KEY=changethis
# Media internal callback ingress exposure suite (Category G, security-tests-m8
# >= 0.4.0). Proves a VALID worker token is still blocked at the public edge for
# /media/v1/internal/* (expect a proxy-layer 404). Set to the plaintext
# MEDIA_INTERNAL_SERVICE_TOKEN shared by worker.env and media.env. The probe URL
# is LIVE_TEST_PUBLIC_BASE + '/' + LIVE_TEST_MEDIA_PUBLIC_PREFIX (default: media).
# LIVE_TEST_MEDIA_INTERNAL_TOKEN=changethis
# LIVE_TEST_MEDIA_PUBLIC_PREFIX=media
# API-key Redis-degraded fail-closed suite (Category N, security-tests-m8 >= 0.4.0).
# Asserts a VALID API key is refused with 503 while Redis is down. It needs a real
# plaintext key minted OUT OF BAND before stopping Redis (a degraded stack can't
# mint one via login), so leave LIVE_TEST_API_KEY unset for normal runs. This
# stack keeps the media limiter at its default MEDIA_RATE_LIMIT_FAILURE_MODE=
# fail_open, so a valid key is accepted (not 503) during an outage: keep
# STRICT_RATE_LIMIT=false (the assertion self-skips). Set it true only against a
# stack running MEDIA_RATE_LIMIT_FAILURE_MODE=fail_closed.
# LIVE_TEST_API_KEY=changethis
# LIVE_TEST_API_KEY_STRICT_RATE_LIMIT=false

# Live tests: per-request timeout in seconds.
LIVE_TEST_TIMEOUT=10
# Live tests: abort the run when the preflight fails (true | false).
LIVE_TEST_FAIL_FAST_PREFLIGHT=true
# Live tests: refuse to run as FIRST_SUPERUSER (keep true).
LIVE_TEST_FORBID_BOOTSTRAP_SUPERUSER=true
# Live tests: JSON map service -> authenticated GET paths expected to return
# 401/403 without a token.
LIVE_TEST_PROTECTED_ENDPOINTS={"media":["/category/","/dashboard/users/activity/","/dashboard/users/activity/current/","/v1/objects","/v1/presets","/v1/admin/storage/stats","/v1/admin/uploads/stale","/v1/admin/maintenance/orphans","/v1/admin/subscriptions"]}
# Live tests: public TLS entrypoint URL.
LIVE_TEST_PUBLIC_BASE=https://localhost:4430
# Live tests: verify the public entrypoint's TLS certificate (false for self-
# signed dev certs).
LIVE_TEST_PUBLIC_TLS_VERIFY=false
# Live tests: absolute path of the stack whose keys/ the asymmetric key-leak
# checks read.
LIVE_TEST_REPO_ROOT=/workspace/media-service-m8/docker_compose/dev_local_media_m8
# Live tests: absolute path of the deployed stack directory.
LIVE_TEST_DEPLOYMENT_ROOT=/workspace/media-service-m8/docker_compose/dev_local_media_m8
# Absolute path of the hardened_m8 stack; live tests read its keys/ for key-
# leak checks.
HARDENED_M8_STACK_ROOT=/workspace/media-service-m8/docker_compose/dev_local_media_m8
