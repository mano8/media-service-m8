
prometheus/data/*
grafana/data/*
db_data/*
mysql_db/*
db/*
redis/*
media_redis/*
minio/data/*
seaweedfs/data/*
# Generated by storage-config from .env + media.env — carries the storage admin
# and media-rw credentials verbatim. Never commit it.
seaweedfs/config/s3.json
# Minted at boot by storage-tls-init; s3.key is the S3 gRPC server's private
# key. seaweedfs/security.toml points at these and IS tracked (no secret).
seaweedfs/tls/
# Garage alt profile (docker-compose.garage.yml, T27) — runtime data only;
# garage/garage.toml carries no secret and IS tracked.
garage/data/*
# Production overlay secrets (docker-compose.production.yml says to ignore this
# directory; this is that line).
secrets/
traefik/certs/*.pem
traefik/certs/*.crt
traefik/certs/*.key
*.pem
*README_DEV*
*.env

# Generated at runtime — never commit (migrations are autogenerated on compose up)
shared_migrations/
# Local signing keys generated by init.sh
keys/
# T25 data-migration reports (rclone check/hashsum output) - runtime output
migration-reports/
